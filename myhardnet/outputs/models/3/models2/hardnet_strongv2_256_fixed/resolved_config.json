{
  "seed": 42,
  "output_dir": "../outputs/models/hardnet_train_strong_v2_256_fixed_candidate_pool_v3",
  "data": {
    "train_csv": "../outputs/butieping/train_pairs.csv",
    "val_csv": "../outputs/butieping/val_pairs.csv",
    "normalize": true,
    "train_augmentation": {
      "enabled": true,
      "probability": 0.7,
      "max_rotation_degrees": 5.0,
      "max_translation_pixels": 1.0,
      "scale_jitter": 0.03,
      "contrast_jitter": 0.1,
      "gamma_jitter": 0.1,
      "blur_probability": 0.15,
      "max_blur_radius": 0.4,
      "noise_probability": 0.25,
      "max_noise_std": 2.0
    },
    "num_workers": 4,
    "pin_memory": false,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "max_train_rows": null,
    "max_val_rows": null,
    "max_train_rows_per_finger": null,
    "max_val_rows_per_finger": null
  },
  "model": {
    "architecture": "hardnet_strong_v2",
    "descriptor_dim": 256,
    "dropout": 0.12,
    "drop_path_rate": 0.08,
    "final_bn_affine": false
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "channels_last": true,
    "cudnn_benchmark": false,
    "allow_tf32": true,
    "epochs": 100,
    "steps_per_epoch": 1000,
    "batch_size": 256,
    "fingers_per_batch": 30,
    "hard_negative_strategy": "same_finger_allowed",
    "same_finger_min_coordinate_separation_px": 16.0,
    "hard_negative_top_k": 3,
    "hard_negative_top1_weight": 0.6,
    "positive_tail_loss_weight": 0.1,
    "positive_tail_p95_weight": 0.7,
    "positive_tail_p99_weight": 0.3,
    "positive_tail_p95_target": 0.6,
    "positive_tail_p99_target": 0.8,
    "margin": 0.9,
    "early_stop_patience": 0,
    "early_stop_min_relative_improvement": 0.002,
    "scheduler": "warmup_cosine",
    "warmup_epochs": 3,
    "eta_min": 0.0001,
    "log_interval": 50
  },
  "validation": {
    "protocol": "fixed_candidate_pool_v3",
    "seed": 10042,
    "finger_count": 7,
    "batch_count": 256,
    "batch_size": 32
  },
  "checkpoint_selection": {
    "strategy": "matching_composite_v1",
    "weights": {
      "loss": 0.3,
      "distance_gap": 0.2,
      "fpr_at_tpr95": 0.35,
      "pos_p95": 0.15
    }
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.08,
    "momentum": 0.9,
    "nesterov": true,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  }
}