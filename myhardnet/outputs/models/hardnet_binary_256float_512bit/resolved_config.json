{
  "seed": 42,
  "output_dir": "../outputs/models/hardnet_binary_256float_512bit",
  "data": {
    "train_csv": "../outputs/butieping/train_pairs.csv",
    "val_csv": "../outputs/butieping/val_pairs.csv",
    "normalize": true,
    "num_workers": 4,
    "pin_memory": false,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "max_train_rows": null,
    "max_val_rows": null,
    "max_train_rows_per_finger": null,
    "max_val_rows_per_finger": null
  },
  "backbone": {
    "checkpoint": "/root/autodl-tmp/mobilenetv2hardnet32-main/myhardnet/outputs/models/hardnet_train_strong_v2_256_fixed_in_batch_v1/best.pt",
    "architecture": "hardnet_strong_v2",
    "descriptor_dim": 256
  },
  "binary_model": {
    "hash_bits": 512,
    "hidden_multiplier": 2.0,
    "dropout": 0.1,
    "temperature_start": 1.0,
    "temperature_end": 0.1,
    "backbone_trainable": false,
    "bitorder": "little"
  },
  "binary_loss": {
    "metric_weight": 1.0,
    "teacher_similarity_weight": 0.5,
    "positive_consistency_weight": 0.1,
    "quantization_weight": 0.1,
    "balance_weight": 0.02,
    "decorrelation_weight": 0.02
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "channels_last": true,
    "cudnn_benchmark": false,
    "allow_tf32": true,
    "epochs": 150,
    "steps_per_epoch": 1000,
    "batch_size": 256,
    "fingers_per_batch": 30,
    "hard_negative_strategy": "same_finger_allowed",
    "same_finger_min_coordinate_separation_px": 16.0,
    "hard_negative_top_k": 3,
    "margin": 0.5,
    "grad_clip_norm": 5.0,
    "early_stop_patience": 0,
    "early_stop_min_relative_improvement": 0.002,
    "scheduler": "warmup_cosine",
    "warmup_epochs": 2,
    "eta_min": 1e-05,
    "log_interval": 50
  },
  "validation": {
    "protocol": "fixed_in_batch_v1",
    "seed": 10042,
    "finger_count": 7,
    "batch_count": 256,
    "batch_size": 24,
    "margin": 0.1
  },
  "checkpoint_selection": {
    "strategy": "matching_composite_v1",
    "weights": {
      "false_acceptance": 0.45,
      "low_fpr_recall": 0.2,
      "hard_negative_recall": 0.15,
      "mean_gap": 0.1,
      "tail_gap": 0.1
    }
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  }
}