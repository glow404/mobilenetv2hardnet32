{
  "seed": 42,
  "output_dir": "../outputs/hardnet_train_post_nips_lr10",
  "data": {
    "train_csv": "../outputs/hardnet_dataset/train_pairs.csv",
    "val_csv": "../outputs/hardnet_dataset/val_pairs.csv",
    "test_csv": "../outputs/hardnet_dataset/test_pairs.csv",
    "normalize": true,
    "num_workers": 0,
    "pin_memory": false,
    "max_train_rows": null,
    "max_val_rows": null,
    "max_train_rows_per_finger": null,
    "max_val_rows_per_finger": null
  },
  "model": {
    "dropout": 0.3,
    "final_bn_affine": false
  },
  "training": {
    "device": "auto",
    "epochs": 300,
    "steps_per_epoch": 1000,
    "val_steps": 200,
    "batch_size": 256,
    "fingers_per_batch": 32,
    "margin": 1.0,
    "early_stop_patience": 0,
    "early_stop_min_relative_improvement": 0.002,
    "scheduler": "warmup_cosine",
    "warmup_epochs": 2,
    "eta_min": 0.0001,
    "log_interval": 50
  },
  "optimizer": {
    "lr": 10.0,
    "momentum": 0.9,
    "weight_decay": 0.0001
  }
}