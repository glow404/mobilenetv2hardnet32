{
  "seed": 42,
  "output_dir": "../outputs/hardnet_train_mobile_fixed_v1",
  "data": {
    "train_csv": "../pair_build/hardnet_dataset/train_pairs.csv",
    "val_csv": "../pair_build/hardnet_dataset/val_pairs.csv",
    "test_csv": "../pair_build/hardnet_dataset/test_pairs.csv",
    "normalize": true,
    "num_workers": 4,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "max_train_rows": null,
    "max_val_rows": null,
    "max_train_rows_per_finger": null,
    "max_val_rows_per_finger": null
  },
  "model": {
    "architecture": "mobile_hardnet",
    "descriptor_dim": 128,
    "dropout": 0.1,
    "final_bn_affine": false
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "channels_last": true,
    "cudnn_benchmark": true,
    "allow_tf32": true,
    "epochs": 300,
    "steps_per_epoch": 1000,
    "batch_size": 256,
    "fingers_per_batch": 32,
    "hard_negative_strategy": "same_finger_allowed",
    "hard_negative_top_k": 3,
    "margin": 0.8,
    "early_stop_patience": 0,
    "early_stop_min_relative_improvement": 0.002,
    "scheduler": "warmup_cosine",
    "warmup_epochs": 2,
    "eta_min": 0.0001,
    "log_interval": 50
  },
  "validation": {
    "protocol": "fixed_pairs_v1",
    "seed": 10042,
    "positive_count": 16384,
    "same_finger_negatives_per_anchor": 32,
    "cross_finger_negatives_per_anchor": 32,
    "batch_size": 256
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.1,
    "momentum": 0.9,
    "nesterov": true,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  }
}