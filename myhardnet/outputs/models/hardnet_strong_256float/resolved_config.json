{
  "seed": 42,
  "output_dir": "../outputs/models/hardnet_train_strong_v2_256_fixed_in_batch_v1",
  "data": {
    "train_csv": "../outputs/butieping/train_pairs.csv",
    "val_csv": "../outputs/butieping/val_pairs.csv",
    "normalize": true,
    "num_workers": 4,
    "pin_memory": false,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "max_train_rows": null,
    "max_val_rows": null,
    "max_train_rows_per_finger": null,
    "max_val_rows_per_finger": null
  },
  "model": {
    "architecture": "hardnet_strong_v2",
    "descriptor_dim": 256,
    "dropout": 0.12,
    "final_bn_affine": false
  },
  "training": {
    "device": "cuda",
    "mixed_precision": "fp16",
    "channels_last": true,
    "cudnn_benchmark": false,
    "allow_tf32": true,
    "epochs": 100,
    "steps_per_epoch": 1000,
    "batch_size": 256,
    "fingers_per_batch": 30,
    "hard_negative_strategy": "same_finger_allowed",
    "same_finger_min_coordinate_separation_px": 16.0,
    "hard_negative_top_k": 3,
    "margin": 0.8,
    "early_stop_patience": 0,
    "early_stop_min_relative_improvement": 0.002,
    "scheduler": "warmup_cosine",
    "warmup_epochs": 3,
    "eta_min": 0.0001,
    "log_interval": 50
  },
  "validation": {
    "protocol": "fixed_in_batch_v1",
    "seed": 10042,
    "finger_count": 7,
    "batch_count": 256,
    "batch_size": 64
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.08,
    "momentum": 0.9,
    "nesterov": true,
    "weight_decay": 0.0001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08
  }
}